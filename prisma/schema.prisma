// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

model PrivacySetting {
  id                      String         @id @default(cuid())

  userId                  String         @unique
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  postsVisibility         Visibility @default(PUBLIC)
  friendsListVisibility   Visibility @default(PUBLIC)
  followersVisibility     Visibility @default(PUBLIC)
  followingVisibility     Visibility @default(PUBLIC)
  bioVisibility           Visibility @default(PUBLIC)
  contactVisibility       Visibility @default(PUBLIC)
  searchVisibility        Boolean        @default(true)
  allowTagReview          Boolean        @default(false)

  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  
}

model CommentMention {
  id              String   @id @default(cuid())

  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  mentionedUserId String
  mentionedUser   User     @relation("UserCommentMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
}

model CommentReport {
  id           String               @id @default(cuid())

  commentId    String
  comment      Comment              @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterId   String
  reporter     User                 @relation("UserCommentReports", fields: [reporterId], references: [id], onDelete: Cascade)

  reason       CommentReportReason
  status       CommentReportStatus  @default(PENDING)
  description  String?

  handledById  String?
  handledBy    User?                @relation("UserHandledCommentReports", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt    DateTime?
  resolutionNote String?

  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([commentId, createdAt])
  @@index([reporterId, createdAt])
  @@index([handledById, handledAt])
}

model CommentEditHistory {
  id               String   @id @default(cuid())

  commentId        String
  comment          Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  editedById       String?
  editedBy         User?    @relation("UserCommentEdits", fields: [editedById], references: [id], onDelete: SetNull)

  previousContent  String?
  previousRichContent Json?
  changeSummary    String?
  metadata         Json?
  editedAt         DateTime @default(now())

  @@index([commentId, editedAt])
  @@index([editedById, editedAt])
}

model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  coverUrl    String?
  isFeatured  Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       PostTopic[]

  @@index([isFeatured])
  @@index([createdAt])
}

model PostTopic {
  id       String @id @default(cuid())

  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  topicId  String
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, topicId])
  @@index([topicId, createdAt])
}

model PostDraft {
  id          String   @id @default(cuid())

  authorId    String
  author      User     @relation("UserPostDrafts", fields: [authorId], references: [id], onDelete: Cascade)

  content     String?
  richContent Json?
  mediaDraft  Json?
  visibility  Visibility @default(PUBLIC)
  metadata    Json?
  expiresAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, updatedAt])
  @@index([expiresAt])
}

model PostAnalyticsDaily {
  id        String   @id @default(cuid())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  date      DateTime
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  bookmarks Int      @default(0)
  reach     Int      @default(0)
  metadata  Json?

  @@unique([postId, date])
  @@index([date])
}

model PostModerationLog {
  id          String                @id @default(cuid())

  postId      String
  post        Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)

  moderatorId String
  moderator   User                  @relation("UserPostModerationLogs", fields: [moderatorId], references: [id], onDelete: Cascade)

  action      PostModerationAction
  reason      String?
  notes       String?
  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
  @@index([moderatorId, createdAt])
}

model HashtagFollow {
  id         String   @id @default(cuid())

  hashtagId  String
  hashtag    Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("UserHashtagFollows", fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([hashtagId, userId])
  @@index([userId, createdAt])
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model MessageReaction {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("UserMessageReactions", fields: [userId], references: [id], onDelete: Restrict)
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId, emoji])
  @@index([userId, createdAt])
}

model Hashtag {
  id             String        @id @default(cuid())
  slug           String        @unique
  label          String
  description    String?
  usageCount     Int           @default(0)
  postsCount     Int           @default(0)
  followersCount Int           @default(0)
  trendingScore  Float         @default(0)
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  posts          PostHashtag[]
  followers      HashtagFollow[]

  @@index([usageCount])
  @@index([postsCount])
  @@index([trendingScore])
}

model PostHashtag {
  id        String   @id @default(cuid())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, hashtagId])
  @@index([hashtagId, createdAt])
}

model PostMention {
  id              String   @id @default(cuid())

  postId          String
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  mentionedUserId String
  mentionedUser   User     @relation("UserPostMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([postId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
}

model PostView {
  id         String   @id @default(cuid())

  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  viewerId   String?
  viewer     User?    @relation("UserPostViews", fields: [viewerId], references: [id], onDelete: SetNull)

  sessionHash String?
  country     String?
  device      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@unique([postId, viewerId])
  @@unique([postId, sessionHash])
  @@index([postId, createdAt])
  @@index([viewerId, createdAt])
}

model PostReport {
  id          String           @id @default(cuid())

  postId      String
  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterId  String
  reporter    User             @relation("UserPostReports", fields: [reporterId], references: [id], onDelete: Cascade)

  reason      PostReportReason
  status      PostReportStatus @default(OPEN)
  description String?

  handledById String?
  handledBy   User?            @relation("UserHandledPostReports", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  resolutionNote String?

  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([postId, createdAt])
  @@index([reporterId, createdAt])
  @@index([handledById, handledAt])
}

model Follow {
  id         String   @id @default(cuid())

  followerId String
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id])

  followingId String
  following    User    @relation("UserFollowers", fields: [followingId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model FollowRequest {
  id          String               @id @default(cuid())

  requesterId String
  requester   User                 @relation("FollowRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  receiverId  String
  receiver    User                 @relation("FollowRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  status      FollowRequestStatus  @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?
  notificationId String?

  @@unique([requesterId, receiverId])
  @@index([receiverId, status, createdAt])
}

model FriendRequest {
  id          String                @id @default(cuid())

  requesterId String
  requester   User                  @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  receiverId  String
  receiver    User                  @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  status      FriendRequestStatus   @default(PENDING)
  createdAt   DateTime              @default(now())
  respondedAt DateTime?
  notificationId String?

  @@unique([requesterId, receiverId])
  @@index([receiverId, status, createdAt])
}

model Friend {
  id         String   @id @default(cuid())

  userOneId  String
  userOne    User     @relation("UserFriendOne", fields: [userOneId], references: [id], onDelete: Cascade)

  userTwoId  String
  userTwo    User     @relation("UserFriendTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userOneId, userTwoId])
  @@index([userOneId, createdAt])
  @@index([userTwoId, createdAt])
}

model Block {
  id        String @id @default(cuid())

  blockerId String
  blocker   User   @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
}

model Comment {
  id          String   @id @default(cuid())

  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Restrict)

  authorId    String
  author      User     @relation("UserComments", fields: [authorId], references: [id], onDelete: Restrict)

  content     String
  richContent Json?

  parentId    String?
  parent      Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Comment[] @relation("CommentReplies")

  depth       Int      @default(0)
  path        String?

  reactions   CommentReaction[]
  reactionsCount Int  @default(0)
  reactionSummary Json?
  replyCount  Int     @default(0)

  isEdited    Boolean @default(false)
  isDeleted   Boolean @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("UserDeletedComments", fields: [deletedById], references: [id], onDelete: SetNull)
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentions    CommentMention[]
  reports     CommentReport[]
  editHistory CommentEditHistory[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@index([deletedById])
}

model CommentReaction {
  id         String   @id @default(cuid())

  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Restrict)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  emoji      String
  createdAt  DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId, emoji])
  @@index([commentId, createdAt])
  @@index([userId, createdAt])
}

model PostShare {
  id          String        @id @default(cuid())

  postId      String
  post        Post          @relation(fields: [postId], references: [id])

  sharedById  String
  sharedBy    User          @relation(fields: [sharedById], references: [id])

  channel     ShareChannel  @default(FEED)
  message     String?
  metadata    Json?

  createdAt   DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([sharedById, createdAt])
  @@unique([postId, sharedById, channel])
}






model User {
  id                String   @id @default(cuid())
  username          String   @unique
  name              String
  firstName         String
  lastName          String
  email             String   @unique
  password          String
  phone             String   @unique

  // Profile
  bio               String?
  websiteUrl        String?
  avatarUrl         String?
  coverUrl          String?
  gender            Gender
  birthDate         DateTime

  // Privacy & status
  isPrivate         Boolean  @default(false)
  isVerified        Boolean  @default(false)
  role              UserRole @default(USER)
  isSuspended       Boolean  @default(false)
  suspendedUntil    DateTime?
  deactivatedAt     DateTime?

  // Activity & counters
  followersCount    Int      @default(0)
  followingCount    Int      @default(0)
  friendsCount      Int      @default(0)
  postsCount        Int      @default(0)
  lastLoginAt       DateTime?
  lastSeenAt        DateTime?
  language          String?
  timezone          String?
  totalInteractedUsers Int @default(0)

  // Account security
  emailVerified     Boolean  @default(false)
  verificationToken String?
  verificationTokenExpiry DateTime?
  // Password reset & account security
  resetToken        String?
  resetTokenExpiry  DateTime?
  failedAttempts    Int      @default(0)
  lockedUntil       DateTime?
  tempToken         String?
  tempEmail         String?
  tempTokenExpiry   DateTime?

  // Notifications
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsTriggered Notification[] @relation("NotificationActor")
  posts              Post[]   @relation("UserPosts")
  postReactions      PostReaction[]
  commentReactions   CommentReaction[]
  postShares         PostShare[]
  postBookmarks      Bookmark[]
  comments           Comment[] @relation("UserComments")
  postMentions       PostMention[] @relation("UserPostMentions")
  commentMentions    CommentMention[] @relation("UserCommentMentions")
  hashtagFollows     HashtagFollow[] @relation("UserHashtagFollows")
  postViews          PostView[] @relation("UserPostViews")
  postReports        PostReport[] @relation("UserPostReports")
  handledPostReports PostReport[] @relation("UserHandledPostReports")
  commentReports     CommentReport[] @relation("UserCommentReports")
  handledCommentReports CommentReport[] @relation("UserHandledCommentReports")
  commentEditHistory CommentEditHistory[] @relation("UserCommentEdits")
  deletedComments    Comment[] @relation("UserDeletedComments")
  postDrafts         PostDraft[] @relation("UserPostDrafts")
  postModerationLogs PostModerationLog[] @relation("UserPostModerationLogs")
  followers          Follow[]  @relation("UserFollowers")
  following          Follow[]  @relation("UserFollowing")
  followRequestsSent     FollowRequest[] @relation("FollowRequestRequester")
  followRequestsReceived FollowRequest[] @relation("FollowRequestReceiver")
  friendRequestsSent     FriendRequest[] @relation("FriendRequestRequester")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestReceiver")
  friendsAsUserOne       Friend[]        @relation("UserFriendOne")
  friendsAsUserTwo       Friend[]        @relation("UserFriendTwo")
  blocks             Block[]  @relation("UserBlocks")
  blockedBy          Block[]  @relation("UserBlockedBy")
  conversationsOwned Conversation[] @relation("UserCreatedConversations")
  conversationMemberships ConversationParticipant[] @relation("UserConversations")
  messagesSent       Message[] @relation("UserMessages")
  messageReceipts    MessageReceipt[] @relation("UserMessageReceipts")
  messageReactions   MessageReaction[] @relation("UserMessageReactions")
  supportTicketsCreated SupportTicket[] @relation("UserCreatedTickets")
  supportTicketsAssigned SupportTicketAssignment[] @relation("UserAssignedTickets")
  supportTicketMessages SupportTicketMessage[] @relation("UserTicketMessages")
  privacySetting    PrivacySetting?
  interactionsAuthored UserInteractionStats[] @relation("UserInteractionActor")
  interactionsTargeted UserInteractionStats[] @relation("UserInteractionTarget")

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
  @@index([lastSeenAt])
  @@index([role])
  @@index([username, email])
  @@index([firstName, lastName])
}


  /// Global settings (singleton row)
  model Setting {
    id       String  @id @default("default")
    siteName String  @default("MYBOOK")
    senderEmail String? // Resend sender address
    updatedAt DateTime @updatedAt
}



model Notification {
  id          String   @id @default(cuid())

  // person who received the notification
  userId      String
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id])

  // person who triggered the notification (like - comment - follow)
  actorId     String
  actor       User     @relation("NotificationActor", fields: [actorId], references: [id])

  type        NotificationType

  // links based on notification type
  postId      String? 
  commentId   String?
  followId    String?

  // arbitrary payload for future-proofing (e.g. snippets, counts)
  metadata    Json?

  // is read or not
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([actorId, createdAt])
  @@index([postId, createdAt])
  @@index([commentId, createdAt])
  @@index([followId, createdAt])
}

model Post {
  id            String        @id @default(cuid())

  authorId      String
  author        User          @relation("UserPosts", fields: [authorId], references: [id], onDelete: Restrict)

  content       String?
  richContent   Json?
  media         Media[]
  linkPreview   Json?

  visibility    Visibility @default(PUBLIC)
  visibilityPreference PostVisibilityPreference @default(ACCOUNT_DEFAULT)
  type          PostType       @default(ORIGINAL)

  replyToId     String?
  replyTo       Post?         @relation("PostReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Post[]        @relation("PostReplies")

  repostOfId    String?
  repostOf      Post?         @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts       Post[]        @relation("PostReposts")

  reactions     PostReaction[]
  reactionsCount Int          @default(0)
  reactionSummary Json?       // aggregate counts per emoji
  commentsCount Int           @default(0)
  sharesCount   Int           @default(0)
  bookmarksCount Int          @default(0)
  viewCount     Int           @default(0)
  shares        PostShare[]
  bookmarks     Bookmark[]
  comments      Comment[]
  mentions      PostMention[]
  hashtags      PostHashtag[]
  views         PostView[]
  reports       PostReport[]
  topics        PostTopic[]
  analytics     PostAnalyticsDaily[]
  moderationLogs PostModerationLog[]

  isPinned      Boolean       @default(false)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?

  location      String?
  language      String?

  publishedAt   DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  metadata      Json?

  @@index([authorId, publishedAt])
  @@index([visibility, publishedAt])
  @@index([visibilityPreference, publishedAt])
  @@index([isDeleted, publishedAt])
  @@index([isDeleted, authorId, publishedAt])
  @@index([isDeleted, visibility, publishedAt])
  @@index([deletedAt])
  @@index([replyToId])
  @@index([repostOfId])
}

model Media {
  id        String    @id @default(cuid())

  postId    String
  post      Post      @relation(fields: [postId], references: [id])

  url       String
  type      MediaType @default(IMAGE)
  width     Int?
  height    Int?
  duration  Int?

  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
}

model PostReaction {
  id        String   @id @default(cuid())

  postId    String
  post      Post     @relation(fields: [postId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  emoji     String   // store unicode emoji or shortcode

  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId, emoji])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())

  postId    String
  post      Post     @relation(fields: [postId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model SupportTicket {
  id             String              @id @default(cuid())
  subject        String
  description    String
  status         SupportTicketStatus @default(OPEN)
  priority       SupportTicketPriority @default(MEDIUM)
  category       SupportTicketCategory @default(GENERAL)
  createdById    String
  createdBy      User                @relation("UserCreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo     SupportTicketAssignment[]
  messages       SupportTicketMessage[]
  tags           Json?
  metadata       Json?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, priority, createdAt])
  @@index([createdById, createdAt])
  @@index([category, createdAt])
}

model SupportTicketAssignment {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("UserAssignedTickets", fields: [userId], references: [id], onDelete: Restrict)
  role        SupportAgentRole @default(AGENT)
  assignedAt  DateTime      @default(now())
  unassignedAt DateTime?
  metadata    Json?

  @@unique([ticketId, userId])
  @@index([userId, assignedAt])
}

model SupportTicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("UserTicketMessages", fields: [senderId], references: [id], onDelete: Restrict)
  body        String
  attachments Json?
  internal    Boolean       @default(false)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ticketId, createdAt])
  @@index([senderId, createdAt])
}

model Conversation {
  id              String             @id @default(cuid())
  type            ConversationType   @default(DIRECT)
  title           String?
  description     String?
  avatarUrl       String?
  createdById     String
  createdBy       User               @relation("UserCreatedConversations", fields: [createdById], references: [id], onDelete: Restrict)
  participants    ConversationParticipant[]
  messages        Message[]          @relation("ConversationMessages")
  lastMessageId   String?           @unique
  lastMessage     Message?           @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  lastMessageSentAt DateTime?
  isArchived      Boolean            @default(false)
  lastActivityAt  DateTime           @default(now())
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([type, createdAt])
  @@index([createdById, createdAt])
  @@index([lastActivityAt])
  @@index([lastMessageSentAt])
}

model ConversationParticipant {
  id                 String                  @id @default(cuid())
  conversationId     String
  conversation       Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId             String
  user               User                    @relation("UserConversations", fields: [userId], references: [id], onDelete: Restrict)
  role               ConversationParticipantRole @default(MEMBER)
  joinedAt           DateTime                @default(now())
  lastReadAt         DateTime?
  mutedUntil         DateTime?
  isPinned           Boolean                 @default(false)
  metadata           Json?
  createdAt          DateTime                @default(now())

  @@unique([conversationId, userId])
  @@index([userId, createdAt])
}

model Message {
  id               String        @id @default(cuid())
  conversationId   String
  conversation     Conversation  @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Restrict)
  featuredInConversation Conversation? @relation("ConversationLastMessage")
  senderId         String
  sender           User          @relation("UserMessages", fields: [senderId], references: [id], onDelete: Restrict)
  body             String?
  richContent      Json?
  type             MessageType   @default(TEXT)
  replyToMessageId String?
  replyTo          Message?      @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]     @relation("MessageReplies")
  attachments      MessageAttachment[]
  receipts         MessageReceipt[]
  reactions        MessageReaction[]
  metadata         Json?
  isEdited         Boolean       @default(false)
  isDeleted        Boolean       @default(false)
  sentAt           DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([conversationId, sentAt])
  @@index([senderId, sentAt])
  @@index([replyToMessageId])
}

model MessageAttachment {
  id         String                 @id @default(cuid())
  messageId  String
  message    Message                @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type       MessageAttachmentType  @default(FILE)
  url        String
  publicId   String?
  previewUrl String?
  size       Int?
  mimeType   String?
  width      Int?
  height     Int?
  duration   Int?
  metadata   Json?
  createdAt  DateTime               @default(now())

  @@index([messageId, createdAt])
}

model MessageReceipt {
  id         String                @id @default(cuid())
  messageId  String
  message    Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId     String
  user       User                  @relation("UserMessageReceipts", fields: [userId], references: [id], onDelete: Restrict)
  status     MessageReceiptStatus  @default(DELIVERED)
  deliveredAt DateTime?
  readAt     DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([messageId, userId])
  @@index([userId, status, createdAt])
  @@index([messageId, status])
}



model UserInteractionStats {
  id            String   @id @default(cuid())

  userId        String
  user          User     @relation("UserInteractionActor", fields: [userId], references: [id], onDelete: Cascade)

  targetUserId  String
  targetUser    User     @relation("UserInteractionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  
  // Counters
  messagesCount   Int      @default(0)
  reactionsCount  Int      @default(0) 
  commentsCount   Int      @default(0)
  sharesCount     Int      @default(0)  
  profileVisits   Int      @default(0)

  // Timers
  lastMessageAt     DateTime?
  lastReactionAt    DateTime? 
  lastCommentAt     DateTime?
  lastShareAt       DateTime? 
  lastVisitAt       DateTime?
  lastInteractionAt DateTime?

  // Status
  isFriend     Boolean @default(false)
  isFollowing  Boolean @default(false)

  // Scores
  interactionWeight Float @default(0)

  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([userId, targetUserId])
  @@index([userId])
  @@index([targetUserId])
}

