# E2E/test environment
E2E=true
E2E_MAIL_MODE=noop

# SQLite test database (created in prisma/test-e2e.db)
DATABASE_URL=file:./prisma/test-e2e.db

# NextAuth
NEXTAUTH_SECRET=0123456789abcdef0123456789abcdef
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=test-google-id
GOOGLE_CLIENT_SECRET=test-google-secret

# Public app URL used by signup route for verify link
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mail provider key (unused in E2E noop mode)
RESEND_API_KEY=unused-for-e2e

# Algolia (public) keys for E2E. Values are dummy; Playwright will intercept network calls.
NEXT_PUBLIC_ALGOLIA_APP_ID=dummy-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=dummy-search-key

# Stripe (dummy secrets for E2E)
STRIPE_SECRET_KEY=sk_test_e2e_dummy
STRIPE_WEBHOOK_SECRET=whsec_e2e_dummy
